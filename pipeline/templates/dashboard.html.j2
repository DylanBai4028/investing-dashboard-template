<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Net worth</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=DM+Sans:wght@400;500;700&family=DM+Mono:wght@400;500&display=swap">
<style>
  :root {
    --bg: #FAF8F5;
    --surface: #FFFFFF;
    --surface-2: #F3EEE6;
    --border: #E4DDD1;
    --text: #2A2420;
    --text-2: #78705F;
    --text-3: #9C9384;
    --accent: #6B4F3A;
    --accent-soft: #EFE6DA;
    --gain: #3F7D5C;
    --gain-soft: #E4EFE9;
    --loss: #B5453A;
    --loss-soft: #F5E7E5;
    --manual: #B8842E;
    --manual-soft: #F5EBD9;
    --cat-1: #B5704A; /* Meridian */
    --cat-2: #C9963E; /* Northbridge */
    --cat-3: #3E7C74; /* Kowhai */
    --cat-4: #8C6A8F; /* Crypto */
    --cat-5: #5A7A9C; /* SouthernCross */
    --shadow: 0 1px 2px rgba(42,36,32,0.04);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #1C1A17; --surface: #242019; --surface-2: #2C2720; --border: #3C362C;
      --text: #F1EBE1; --text-2: #B0A692; --text-3: #857C6C;
      --accent: #D2A47E; --accent-soft: #38302426;
      --gain: #6BC199; --gain-soft: #24352C;
      --loss: #E28A7E; --loss-soft: #3A2624;
      --manual: #E3B563; --manual-soft: #362C1C;
      --cat-1: #C88C63; --cat-2: #D9AE5F; --cat-3: #5FA89E; --cat-4: #AC8AAE; --cat-5: #7C9BBC;
      --shadow: 0 1px 3px rgba(0,0,0,0.3);
    }
  }
  :root[data-theme="dark"] {
    --bg: #1C1A17; --surface: #242019; --surface-2: #2C2720; --border: #3C362C;
    --text: #F1EBE1; --text-2: #B0A692; --text-3: #857C6C;
    --accent: #D2A47E; --accent-soft: #38302426;
    --gain: #6BC199; --gain-soft: #24352C;
    --loss: #E28A7E; --loss-soft: #3A2624;
    --manual: #E3B563; --manual-soft: #362C1C;
    --cat-1: #C88C63; --cat-2: #D9AE5F; --cat-3: #5FA89E; --cat-4: #AC8AAE; --cat-5: #7C9BBC;
    --shadow: 0 1px 3px rgba(0,0,0,0.3);
  }

  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font-family: 'DM Sans', system-ui, sans-serif; font-size: 14px; line-height: 1.5; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: clamp(1.25rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2rem) 4rem; }
  h1, h2, h3 { font-family: 'Fraunces', Georgia, serif; text-wrap: balance; margin: 0; }
  .mono { font-family: 'DM Mono', ui-monospace, monospace; }
  .num { font-variant-numeric: tabular-nums; }
  [hidden] { display: none !important; }

  .topbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .brand { display: flex; align-items: baseline; gap: 0.6rem; }
  .brand h1 { font-size: 20px; font-weight: 600; }
  .mock-badge { font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--manual); background: var(--manual-soft); border: 1px solid var(--manual); border-radius: 4px; padding: 2px 7px; }
  .topbar-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
  .refreshed-at { font-size: 11.5px; color: var(--text-3); }
  .ccy-toggle { display: inline-flex; background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px; padding: 3px; gap: 2px; }
  .ccy-toggle button { border: none; background: transparent; font: inherit; font-size: 13px; font-weight: 500; color: var(--text-2); padding: 5px 12px; border-radius: 6px; cursor: pointer; }
  .ccy-toggle button.active { background: var(--surface); color: var(--text); box-shadow: var(--shadow); }

  .tab-nav { display: flex; gap: 4px; border-bottom: 1px solid var(--border); margin-bottom: 1.5rem; }
  .tab-btn { border: none; background: transparent; font: inherit; font-size: 14px; font-weight: 500; color: var(--text-2); padding: 9px 4px; margin-right: 20px; cursor: pointer; border-bottom: 2px solid transparent; }
  .tab-btn.active { color: var(--text); border-bottom-color: var(--accent); }

  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem 1.4rem; min-width: 0; }
  .card-title { font-size: 13px; font-weight: 500; color: var(--text-2); margin: 0 0 0.9rem; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .card-title .hint { font-weight: 400; color: var(--text-3); font-size: 12px; }

  .hero-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  .hero-cell { background: var(--surface); padding: 1.2rem 1.4rem; }
  .hero-label { font-size: 12.5px; color: var(--text-2); margin-bottom: 0.4rem; }
  .hero-value { font-size: clamp(26px, 3.4vw, 34px); font-weight: 600; }
  .hero-value.big { font-size: clamp(32px, 4.4vw, 44px); }
  .hero-sub { font-size: 12.5px; color: var(--text-3); margin-top: 0.35rem; }
  .delta { font-weight: 500; }
  .delta.pos { color: var(--gain); }
  .delta.neg { color: var(--loss); }

  .substat-row { display: flex; background: var(--surface); border: 1px solid var(--border); border-top: none; border-radius: 0 0 12px 12px; margin: -1.25rem 0 1.25rem; padding: 0.85rem 1.4rem; gap: 2.2rem; flex-wrap: wrap; }
  .substat { display: flex; align-items: baseline; gap: 8px; font-size: 12.5px; color: var(--text-2); }
  .substat b { font-family: 'DM Mono', monospace; font-size: 13px; color: var(--text); font-weight: 500; }
  .substat b.pos { color: var(--gain); }
  .substat b.neg { color: var(--loss); }

  .range-row { display: flex; gap: 6px; flex-wrap: wrap; }
  .range-btn { border: 1px solid var(--border); background: var(--surface); color: var(--text-2); font: inherit; font-size: 12.5px; font-weight: 500; padding: 5px 10px; border-radius: 7px; cursor: pointer; }
  .range-btn.active { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .chart-box { position: relative; width: 100%; min-width: 0; margin-top: 1rem; }

  .row-2 { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 1.25rem; margin: 1.25rem 0; }
  .row-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin: 1.25rem 0; }
  @media (max-width: 800px) { .row-2, .row-3 { grid-template-columns: 1fr; } .hero-grid { grid-template-columns: 1fr 1fr; } }

  .legend { display: flex; flex-wrap: wrap; gap: 12px 16px; margin-top: 0.85rem; font-size: 12.5px; color: var(--text-2); }
  .legend span.sw { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 5px; vertical-align: -1px; }

  #treemap { width: 100%; }
  .tm-node { cursor: pointer; stroke: var(--surface); stroke-width: 2; }
  .tm-label { font-family: 'DM Sans', sans-serif; pointer-events: none; }
  .tm-val { font-family: 'DM Mono', monospace; }

  .bar-list { display: flex; flex-direction: column; gap: 10px; margin-top: 0.9rem; max-height: 420px; overflow-y: auto; padding-right: 4px; }
  .bar-row { cursor: pointer; }
  .bar-row-top { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px; }
  .bar-row-top .name { font-weight: 500; }
  .bar-row-top .pct { color: var(--text-2); font-family: 'DM Mono', monospace; font-size: 12.5px; }
  .bar-track { height: 8px; background: var(--surface-2); border-radius: 4px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 4px; }

  .split-bar { height: 22px; border-radius: 6px; overflow: hidden; display: flex; margin-top: 0.9rem; }
  .split-key { display: flex; justify-content: space-between; margin-top: 0.7rem; font-size: 12.5px; }
  .split-key .side b { font-family: 'DM Mono', monospace; display: block; font-size: 15px; color: var(--text); font-weight: 500; margin-top: 2px; }

  .donut-wrap { display: flex; align-items: center; gap: 1rem; margin-top: 0.7rem; }
  .donut-canvas-box { position: relative; width: 92px; height: 92px; flex-shrink: 0; }
  .donut-legend { display: flex; flex-direction: column; gap: 6px; font-size: 12.5px; color: var(--text-2); }
  .donut-legend .sw { width: 8px; height: 8px; border-radius: 2px; display: inline-block; margin-right: 6px; }
  .donut-legend b { color: var(--text); font-family: 'DM Mono', monospace; font-weight: 500; }

  .view-toggle { display: inline-flex; background: var(--surface-2); border: 1px solid var(--border); border-radius: 7px; padding: 2px; gap: 2px; margin-left: auto; }
  .view-toggle button { border: none; background: transparent; font: inherit; font-size: 12px; font-weight: 500; color: var(--text-2); padding: 3px 9px; border-radius: 5px; cursor: pointer; }
  .view-toggle button.active { background: var(--surface); color: var(--text); box-shadow: var(--shadow); }
  .range-row-wrap { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

  .sector-bar { height: 14px; border-radius: 4px; overflow: hidden; display: flex; margin-top: 0.9rem; }
  .sector-legend { display: flex; flex-wrap: wrap; gap: 10px 18px; margin-top: 0.9rem; font-size: 12.5px; color: var(--text-2); }
  .sector-legend b { color: var(--text); font-family: 'DM Mono', monospace; font-weight: 500; }

  table.platform-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  table.platform-table th { text-align: right; font-weight: 500; color: var(--text-2); font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.03em; padding: 6px 8px; border-bottom: 1px solid var(--border); }
  table.platform-table th:first-child, table.platform-table td:first-child { text-align: left; }
  table.platform-table td { padding: 8px; border-bottom: 1px solid var(--border); text-align: right; font-family: 'DM Mono', monospace; }
  table.platform-table td.plat-name { font-family: 'DM Sans', sans-serif; font-weight: 500; vertical-align: middle; }
  table.platform-table .plat-name-inner { display: flex; align-items: center; gap: 7px; }
  table.platform-table tfoot td { font-weight: 500; border-bottom: none; padding-top: 10px; color: var(--text); }
  table.platform-table tfoot td.plat-name { font-family: 'DM Sans', sans-serif; }

  #drilldown-empty { color: var(--text-3); font-size: 13px; padding: 0.5rem 0 0.25rem; }
  .dd-header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
  .dd-header .dd-name { font-family: 'Fraunces', serif; font-size: 19px; font-weight: 600; }
  .dd-header .dd-meta { font-size: 12.5px; color: var(--text-2); }
  table.dd-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  table.dd-table th { text-align: left; font-weight: 500; color: var(--text-2); font-size: 12px; text-transform: uppercase; letter-spacing: 0.03em; padding: 6px 10px; border-bottom: 1px solid var(--border); }
  table.dd-table td { padding: 7px 10px; border-bottom: 1px solid var(--border); }
  table.dd-table td.mono-cell { font-family: 'DM Mono', monospace; }
  .type-pill { font-size: 11px; font-weight: 500; padding: 2px 7px; border-radius: 999px; }
  .type-pill.buy { background: var(--gain-soft); color: var(--gain); }
  .type-pill.sell { background: var(--loss-soft); color: var(--loss); }
  .type-pill.dividend { background: var(--accent-soft); color: var(--accent); }

  .freshness { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 1.5rem; padding-top: 1.1rem; border-top: 1px solid var(--border); font-size: 12.5px; color: var(--text-2); }
  .freshness .dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; margin-right: 6px; vertical-align: 1px; }
  .dot.fresh { background: var(--gain); }
  .dot.stale { background: var(--manual); }

  .section-gap { margin: 1.25rem 0; }

  .tax-card { text-align: left; }
  .tax-badge { font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--manual); background: var(--manual-soft); border: 1px solid var(--manual); border-radius: 4px; padding: 2px 7px; display: inline-block; margin-bottom: 0.9rem; }
  .tax-list { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .tax-list li { padding-left: 1.1rem; border-left: 2px solid var(--border); }
  .tax-list .t-title { font-weight: 500; font-size: 14px; }
  .tax-list .t-desc { color: var(--text-2); font-size: 13px; margin-top: 2px; }
</style>
</head>
<body>
<div class="wrap">

  <h2 style="position:absolute;width:1px;height:1px;overflow:hidden;">Net worth dashboard: overview tab with total net worth over time, platform and holding breakdowns, currency and broker composition, and a benchmark comparison; a second tab with a worked cross-border tax example.</h2>

  <div class="topbar">
    <div class="brand">
      <h1>Net worth</h1>
      <span class="mock-badge" id="sampleBadge" hidden>Sample data — see freshness</span>
    </div>
    <div class="topbar-right">
      <div class="refreshed-at" id="refreshedAt"></div>
      <div class="ccy-toggle" id="ccyToggle">
        <button data-ccy="AUD" class="active">AUD</button>
        <button data-ccy="NZD">NZD</button>
        <button data-ccy="USD">USD</button>
      </div>
    </div>
  </div>

  <div class="tab-nav" id="tabNav">
    <button class="tab-btn active" data-tab="overview">Overview</button>
    <button class="tab-btn" data-tab="tax">Tax</button>
  </div>

  <div id="panel-overview">

    <div class="hero-grid">
      <div class="hero-cell">
        <div class="hero-label">Total net worth</div>
        <div class="hero-value big num" id="totalNw">$0</div>
        <div class="hero-sub"><span class="delta pos" id="totalDelta">+0%</span> over selected range</div>
      </div>
      <div class="hero-cell">
        <div class="hero-label">Liquid net worth</div>
        <div class="hero-value num" id="liquidNw">$0</div>
        <div class="hero-sub" id="liquidPct">0% of total · excludes SouthernCross</div>
      </div>
      <div class="hero-cell">
        <div class="hero-label">Total contributed</div>
        <div class="hero-value num" id="contribNw">$0</div>
        <div class="hero-sub">Across all platforms, all-time</div>
      </div>
      <div class="hero-cell">
        <div class="hero-label">Unrealized gain / loss</div>
        <div class="hero-value num delta pos" id="unrealizedNw">$0</div>
        <div class="hero-sub">All platforms with cost data · <span id="realizedSub">realized $0</span></div>
      </div>
    </div>
    <div class="substat-row">
      <div class="substat">Day change <b id="dayChange">+$0</b></div>
      <div class="substat" id="sinceLastRow">Since last update <b id="sinceLastDelta">+$0</b></div>
      <div class="substat" id="annualizedRow" hidden>Annualized return <b id="annualizedReturn">+0%</b></div>
    </div>

    <div class="card">
      <div class="card-title">
        <span>Net worth over time</span>
        <span class="hint">Daily, reconstructed from trade history (Meridian/Northbridge/Crypto) and each fund's own ledger (Kowhai/SouthernCross)</span>
      </div>
      <div class="range-row-wrap">
        <div class="range-row" id="rangeRow">
          <button class="range-btn" data-range="1D">1D</button>
          <button class="range-btn" data-range="1W">1W</button>
          <button class="range-btn" data-range="1M">1M</button>
          <button class="range-btn" data-range="1Y">1Y</button>
          <button class="range-btn" data-range="2Y">2Y</button>
          <button class="range-btn" data-range="3Y">3Y</button>
          <button class="range-btn active" data-range="5Y">5Y</button>
          <button class="range-btn" data-range="10Y">10Y</button>
          <button class="range-btn" data-range="ALL">ALL</button>
        </div>
        <div style="display:flex; gap:10px; margin-left:auto;">
          <div class="view-toggle" id="basisToggle" style="margin-left:0;" title="USD basis re-expresses each day's value using that day's own historical AUD/USD rate — unlike the AUD/NZD/USD switcher above, which applies today's rate uniformly and can't change the shape of the curve.">
            <button data-basis="aud" class="active">AUD basis</button>
            <button data-basis="usd">USD basis</button>
          </div>
          <div class="view-toggle" id="viewToggle" style="margin-left:0;">
            <button data-view="dollar" class="active">$</button>
            <button data-view="pct">%</button>
          </div>
        </div>
      </div>
      <div class="chart-box" style="height:280px;">
        <canvas id="nwChart" role="img" aria-label="Line chart of total net worth over time against cumulative contributions, showing investment return as the gap between the two"></canvas>
      </div>
      <div class="legend" id="nwLegend"></div>
    </div>

    <div class="row-3">
      <div class="card">
        <div class="card-title"><span>Stocks: AU vs NZ broker</span><span class="hint">Excludes super &amp; crypto</span></div>
        <div class="split-bar" id="brokerSplitBar"></div>
        <div class="split-key" id="brokerSplitKey"></div>
      </div>
      <div class="card">
        <div class="card-title"><span>Currency exposure</span><span class="hint">All assets</span></div>
        <div class="donut-wrap">
          <div class="donut-canvas-box"><canvas id="ccyDonut" role="img" aria-label="Donut chart of currency exposure across AUD, USD and NZD"></canvas></div>
          <div class="donut-legend" id="ccyDonutLegend"></div>
        </div>
        <div class="hero-sub" id="fxSensitivity" style="margin-top:0.8rem;"></div>
      </div>
      <div class="card">
        <div class="card-title"><span>Asset class</span><span class="hint">All assets</span></div>
        <div class="donut-wrap">
          <div class="donut-canvas-box"><canvas id="classDonut" role="img" aria-label="Donut chart of asset class allocation"></canvas></div>
          <div class="donut-legend" id="classDonutLegend"></div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-title"><span>Sector allocation</span><span class="hint">Equities only — Meridian &amp; Northbridge</span></div>
      <div class="sector-bar" id="sectorBar"></div>
      <div class="sector-legend" id="sectorLegend"></div>
    </div>

    <div class="row-2">
      <div class="card">
        <div class="card-title"><span>Contribution vs. growth</span><span class="hint">What you put in vs. what the market did</span></div>
        <div class="split-bar" id="growthSplitBar"></div>
        <div class="split-key" id="growthSplitKey"></div>
      </div>
      <div class="card">
        <div class="card-title"><span>Today's movers</span><span class="hint">By day change</span></div>
        <div class="bar-list" id="moversList" style="max-height:none;"></div>
      </div>
    </div>

    <div class="card">
      <div class="card-title"><span>Fees paid</span><span class="hint" id="feesHint">Lifetime, all platforms</span></div>
      <div class="sector-bar" id="feesBar"></div>
      <div class="sector-legend" id="feesLegend"></div>
      <div class="hero-sub" style="margin-top:0.7rem;" id="feesCaption">Meridian/Northbridge: brokerage only. Kowhai/SouthernCross: fund administration fees (SouthernCross net of its partial tax rebate). Doesn't include currency-conversion spread on USD trades, which isn't broken out as its own line item in either broker's export.</div>
    </div>

    <div class="card">
      <div class="card-title"><span>Annualized return by platform</span><span class="hint">Money-weighted (XIRR) — see the portfolio-wide figure above for the caveat</span></div>
      <div class="bar-list" id="platformReturnList" style="max-height:none;"></div>
    </div>

    <div class="row-2">
      <div class="card">
        <div class="card-title"><span>Holdings by platform</span><span class="hint">Cost basis, value, day change, gain/loss</span></div>
        <div style="overflow-x:auto;">
          <table class="platform-table" id="platformTable">
            <thead><tr><th style="text-align:left;">Platform</th><th>Symbols</th><th>Cost basis</th><th>Market value</th><th>Day change</th><th>Unrealized</th><th>Realized</th></tr></thead>
            <tbody id="platformTableBody"></tbody>
            <tfoot><tr id="platformTableFoot"></tr></tfoot>
          </table>
        </div>
      </div>
      <div class="card">
        <div class="card-title"><span>Dividend income</span><span class="hint">Trailing 12 months</span></div>
        <div class="chart-box" style="height:150px;">
          <canvas id="divChart" role="img" aria-label="Bar chart of dividend income received per month over the trailing 12 months"></canvas>
        </div>
        <div class="hero-sub" style="margin-top:0.6rem;">Total, trailing 12mo <b class="mono" id="divTTM" style="color:var(--text);">$0</b></div>
      </div>
    </div>

    <div class="row-2">
      <div class="card">
        <div class="card-title"><span>Split by platform, then by holding</span><span class="hint">Box area = value</span></div>
        <div id="treemap"></div>
        <div class="legend" id="tmLegend"></div>
      </div>
      <div class="card">
        <div class="card-title"><span>Every holding, ranked</span><span class="hint">% of total net worth</span></div>
        <div class="bar-list" id="barList"></div>
      </div>
    </div>

    <div class="card section-gap">
      <div class="dd-header">
        <span class="dd-name" id="ddName">Select a holding above</span>
        <span class="dd-meta" id="ddMeta"></span>
      </div>
      <div id="drilldown-empty">Click a box in the treemap, or a row in the ranked list, to see its transaction and dividend history.</div>
      <div style="overflow-x:auto;">
        <table class="dd-table" id="ddTable" style="display:none;">
          <thead><tr><th>Date</th><th>Type</th><th>Quantity</th><th>Price</th><th>Value</th></tr></thead>
          <tbody id="ddBody"></tbody>
        </table>
      </div>
    </div>

    <div class="card section-gap">
      <div class="card-title"><span>Performance vs. major indexes</span><span class="hint">Normalized cumulative return, same range as above — Meridian &amp; Northbridge stock holdings only</span></div>
      <div class="chart-box" style="height:260px;">
